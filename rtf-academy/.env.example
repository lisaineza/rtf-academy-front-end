# --- Backend API ---
# Your Django backend is live at https://rtf-academy-backend.onrender.com
# but nothing is routed at the bare root ("/"), which is why it 404s -
# that's expected for a Django app. Find the real API prefix in your
# backend's urls.py (commonly /api/ or /api/v1/) and put the FULL path here:
VITE_API_BASE_URL=https://rtf-academy-backend.onrender.com/api/v1

# --- Firebase (needed for real login + Google sign-in) ---
# Get these from Firebase Console > Project Settings > General > Your apps > SDK setup.
# Leave them blank to keep running in local demo mode (localStorage auth,
# no Google button) while you wait on Firebase project access.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
