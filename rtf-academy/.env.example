# --- Backend API ---
# For local development, this is usually http://localhost:8000/api/v1.
# If you are using the deployed Render backend, replace it with
# https://rtf-academy-backend.onrender.com/api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Firebase (needed for real login + Google sign-in) ---
# Get these from Firebase Console > Project Settings > General > Your apps > SDK setup.
# Leave them blank to keep running in local demo mode (localStorage auth,
# no Google button) while you wait on Firebase project access.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
